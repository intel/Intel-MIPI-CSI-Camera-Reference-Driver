#!/usr/bin/make -f

export DH_VERBOSE = 1
include /usr/share/dpkg/pkg-info.mk

# Deserializer arch
deserlist := "maxim-serdes max9x"
defaultdeser := maxim-serdes

# SSDT table Camera ACPI device arch (SSDT_overlays or ipu_acpi built-in )  
pdatalist := "grub_ssdt_overlay ipu_acpi_pdata"
defaultpdata := grub_ssdt_overlay

# maxim-serdes Deserializer AIC board types 
ssdtmaximserdeslist := " max9296-swiss max9296-adv-mioe max9296-seavo max9296-axiomtek max96712-jwipc max96724-servoss max96724-servoss_dphy max96724-cexd-intrbl max96724-adv-usbc"
defaultssdtipu := ipu7
defaultssdtboard := max96724-servoss
defaultssdtsensor := d3_isx031

# special characters
empty :=
space := $(empty) $(empty)
comma := ,
semicol := ;

# helper to create comma separated list from space separated list
commasep = $(subst $(space),$(comma)$(space),$1)
semicolsep = $(subst $(space),$(comma),$1)

# remove double quotes
unquote = $(subst $\",,$1)

# recursive wildcard
rwildcard=$(foreach d,$(wildcard $(1:=/*)),$(call rwildcard,$d,$2) $(filter $(subst *,%,$2),$d))

DKMS_PACKAGE_NAME = $(shell grep '^PACKAGE_NAME=' debian/dkms.conf.in | cut -d\" -f2)
DKMS_PACKAGE_VERSION = $(DEB_VERSION_UPSTREAM)
DKMS_PACKAGE_REVISION = $(DEB_VERSION_UPSTREAM_REVISION)

generated_dkms_files = \
  debian/dkms.conf \
  debian/intel-mipi-gmsl-dkms.install \
  debian/intel-mipi-gmsl-dkms.config \
  debian/intel-mipi-gmsl-dkms.templates \
  debian/intel-mipi-gmsl-dkms.postinst \
  debian/intel-mipi-gmsl-dkms.postrm \
  $(empty)

# set iASL compiler
ifeq ($(ASL_COMPILER),)
export ASL_COMPILER:=$(shell which iasl)
ifeq ($(ASL_COMPILER),)
$(error ASL_COMPILER missing)
endif
endif

# acpi/: contains Reference ACPI SSDT-overlay supported configuration
# debian/acpi: add additional, unsupported SSDT-overlay configurations here!
CONFIGDIRS ?= acpi debian/acpi
CONFIGASLS := $(call rwildcard,$(CONFIGDIRS),*.asl)

# This evaluates the attributes of SSDT-overlay config (after unquoting).
# It create the following variables:
#  * ipulist: accumulated list of all Intel IPU versions detected
#  * boardlist: accumulated list of all GMSL AIC  versions detected
#  * sensorlist: accumulated list of all camera sensors configurations detected
#  * config_<ipu>_<board>: respective scenario configuration ASL file
define get-ssdt-data
$(eval ipu := $(notdir $(abspath $(dir $1))))            				\
$(eval ipulist := $(sort $(ipulist) $(ipu)))         					\
$(eval scenario := $(basename $(notdir $1)))               				\
$(foreach f,$(sort $(ssdtmaximserdeslist)),                       			\
	$(if $(filter $(f)_%,$(scenario)),						\
		$(eval sensor := $(subst ${f}_,,$(scenario)))				\
		$(eval board := $(f))				   			\
		$(if $(filter dphy_%,$(sensor)),					\
			$(eval sensor := $(subst ${f}_dphy_,,$(scenario)))	        \
			$(eval board := ${f}_dphy),	        			\
		)									\
		$(eval boardlist := $(sort $(boardlist) $(board)))   			\
		$(if $(filter $(sensor),$(sensorlist)),,				\
			$(eval sensorlist := $(sort $(sensorlist) $(sensor)))   	\
		)									\
		$(eval scenariolist_$(ipu) := $(sort $(scenariolist_$(ipu)) $(board))) 	\
                $(eval config_$(ipu)_$(board) := $(sort $(config_$(ipu)_$(board)) $(sensor))) \
                $(eval asl_filelist := $(sort $(asl_filelist) acpi/$(ipu)/$(board)_$(sensor))), \
	)
)
$(eval undefine scenario)
$(eval undefine sensor)
$(eval undefine board)
$(eval undefine ipu)
endef

# get all ASL data
$(foreach asl,$(CONFIGASLS),$(call get-ssdt-data,$(asl)))
$(foreach b,$(ipulist),$(eval scenariolist_$(b) := $(sort $(scenariolist_$(b)) custom-board)))
$(foreach b,$(ipulist),$(foreach s,$(scenariolist_$(b)),$(eval config_$(b)_$(s) := $(sort $(config_$(b)_$(s)) custom-sensor))))

# uncomment for debugging purposes
#$(info list: $(CONFIGASLS))
#$(info ipulist: $(ipulist))
#$(info boardlist: $(boardlist))
#$(info sensorlist: $(sensorlist))
#$(info asl_filelist: $(asl_filelist))
#$(foreach b,$(ipulist),$(info scenariolist_$(b): $(scenariolist_$(b))))
#$(foreach b,$(ipulist),$(foreach s,$(scenariolist_$(b)),$(info config_$(b)_$(s): $(config_$(b)_$(s)))))
#$(foreach i,$(ipulist),$(foreach b,$(scenariolist_$(i)),$(foreach s,$(config_$(i)_$(b)),$(info $(i)_$(b)_sensor: $(s)))))

# set paths (see also paths.make)
export prefix = /usr
export bindir = $(prefix)/bin
export libdir = $(prefix)/lib/$(DEB_HOST_MULTIARCH)
export nonarchlibdir = $(prefix)/lib
export datadir = $(prefix)/share
export includedir = $(prefix)/include
export systemd_unitdir = /lib/systemd
export docdir = $(datadir)/doc
export sysconfdir = /etc

override_dh_auto_configure: 
	./debian/scripts/dkms-kernel-source.sh "drivers/media/v4l2-core" "include/media" "drivers/media/pci/intel/Kconfig" "drivers/media/pci/intel/Makefile" "drivers/media/pci/intel/ipu-bridge.c" "drivers/media/mc" "include/uapi/linux/media.h"

override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_install:
override_dh_auto_clean:

override_dh_dkms: debian/dkms.conf debian/intel-mipi-gmsl-dkms.postinst
	dh_dkms -V $(DEB_VERSION_UPSTREAM_REVISION) -- debian/dkms.conf
	cp -a debian/intel-mipi-gmsl-dkms.postinst debian/intel-mipi-gmsl-dkms.postinst.debhelper

override_dh_installdebconf-arch: debian/intel-mipi-gmsl-dkms.config debian/intel-mipi-gmsl-dkms.templates
	dh_installdebconf -a

override_dh_install: debian/intel-mipi-gmsl-dkms.install debian/dkms.conf $(asl_filelist)
	dh_install --exclude=.gitignore --exclude=.gitmodules

override_dh_installsystemd:
	dh_installsystemd --no-start --no-restart-on-upgrade --no-restart-after-upgrade --name=v4l2-gmsl-init

override_dh_clean:
	-rm -f $(generated_dkms_files)
	dh_clean

$(asl_filelist): $(asl_filelist:=.asl)
	mkdir -p debian/$(DKMS_PACKAGE_NAME)/usr/share/camera/$(dir $@)
	$(ASL_COMPILER) -p debian/$(DKMS_PACKAGE_NAME)/usr/share/camera/$(@:=.aml) $(@:=.asl)  2>/dev/null || true

$(generated_dkms_files) : $(generated_dkms_files:=.in) debian/rules
	sed -e 's,@DKMS_PACKAGE_NAME@,$(DKMS_PACKAGE_NAME),g' \
	    -e 's,@DKMS_PACKAGE_VERSION@,$(DEB_VERSION_UPSTREAM_REVISION),g' \
	    -e 's,@amldir@,$(datadir)/camera/acpi,g' \
	    -e 's/@deserlist@/$(call unquote,$(deserlist))/g' \
	    -e 's/@sensorlist@/$(call commasep,$(call unquote,$(sensorlist)))/g' \
	    -e 's/@ipulist@/$(call commasep,$(call unquote,$(ipulist)))/g' \
	    -e 's/@boardlist@/($(foreach b,$(ipulist),[$b]="$(call commasep,$(scenariolist_$b))"))/g' \
	    -e 's/@scenarios@/($(foreach b,$(ipulist),$(foreach s,$(scenariolist_$(b)),[$b_$s]="$(call commasep,$(config_$(b)_$(s)))")))/g' \
	    -e 's/@maximserdeslist@/$(call commasep,$(call unquote,$(boardlist)))/g' \
	    -e 's/@marchlist@/$(call commasep,$(call unquote,$(deserlist)))/g' \
	    -e 's/@pdatalist@/$(call commasep,$(call unquote,$(pdatalist)))/g' \
	    -e 's/@defaultsensor@/$(defaultssdtsensor)/g' \
	    -e 's/@defaultipu@/$(defaultssdtipu)/g' \
	    -e 's/@defaultmaximserdes@/$(defaultssdtboard)/g' \
	    -e 's/@marchdefault@/$(defaultdeser)/g' \
	    -e 's/@pdatadefault@/$(defaultpdata)/g' \
	    <$(@:=.in) >$@

### others ###################################################################
%:
	dh $@ --with modaliases
