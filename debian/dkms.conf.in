PATCH[$((++j))]="0060-ipu6-isys-update-v4l2_subdev_stream_configs-api-chan.patch"
PATCH_MATCH[$j]="^(6.1[278])|^(7.[0])"
PATCH[$((++j))]="0061-ipu6-isys-update-vb2_ops-api-changes.patch"
