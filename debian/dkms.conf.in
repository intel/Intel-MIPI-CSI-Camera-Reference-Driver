# kernel patches for Linux 6.18
PATCH[$((++j))]="0207-ipu-bridge-6.18-makefile.patch"
PATCH_MATCH[$j]="^(6.1[8])"
PATCH[$((++j))]="0208-ipu-bridge-6.18-bkc-backport.patch"
