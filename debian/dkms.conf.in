# kernel patches for Linux 6.12
PATCH[$((++j))]="0200-ipu-bridge-port-6.12.0-to-bkc.patch"
PATCH_MATCH[$j]="^(6.1[2]-intel)"
PATCH[$((++j))]="0201-ipu-bridge-6.12-makefile.patch"
