# IPU7 drivers d4xx OoT patches
PATCH[$((++j))]="0102-ipu7-isys-allow-virtual-channels-on-16-csi2-input-vi.patch"
PATCH_MATCH[$j]="^(6.1[278])|^(7.[0])"
PATCH[$((++j))]="0103-ipu7-isys-add-d4xx-pixel-format-support.patch"
