#!/bin/sh
# postrm script for intel-mipi-gmsl-dkms
#
# see: dh_installdeb(1)

DKMS_PACKAGE_NAME=@DKMS_PACKAGE_NAME@

set -e

. /usr/share/debconf/confmodule

db_get ${DKMS_PACKAGE_NAME}/max9x
MAX9X=${RET}
db_get ${DKMS_PACKAGE_NAME}/ipu
IPU=${RET}
db_get ${DKMS_PACKAGE_NAME}/board
BOARD=${RET}
db_get ${DKMS_PACKAGE_NAME}/sensor
SENSOR=${RET}

# summary of how this script can be called:
#        * <postrm> `remove'
#        * <postrm> `purge'
#        * <old-postrm> `upgrade' <new-version>
#        * <new-postrm> `failed-upgrade' <old-version>
#        * <new-postrm> `abort-install'
#        * <new-postrm> `abort-install' <old-version>
#        * <new-postrm> `abort-upgrade' <old-version>
#        * <disappearer's-postrm> `disappear' <overwriter>
#          <overwriter-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

case "$1" in
	remove|purge)
		if [ "$MAX9X" = "maxim-serdes" ]; then
			echo "postrm ${MAX9X} ACPI SSDT-overlay ${IPU}/${BOARD}_${SENSOR}.aml" >&2
			if [ -e /boot/${IPU}_${BOARD}_${SENSOR}_ssdt.img ]; then
				rm -rf /boot/${IPU}_${BOARD}_${SENSOR}_ssdt.img || :
				rm -rf /etc/default/grub.d/ssdt.cfg
			fi
			if command -v update-grub > /dev/null && [ -d /boot/grub ]; then
				update-grub || :
			fi
		fi
	;;
	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;

	*)
		echo "postrm called with unknown argument \`$1'" >&2
        	exit 1
	;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
