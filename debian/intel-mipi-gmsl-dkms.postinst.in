# Automatically added by dh_dkms/3.0.10-7
# The original file can be found in template-dkms-mkdeb/debian/postinst
# in the DKMS tarball, check it for copyright notices.

DKMS_NAME=@DKMS_PACKAGE_NAME@
DKMS_PACKAGE_NAME=@DKMS_PACKAGE_NAME@
DKMS_VERSION=@DKMS_PACKAGE_VERSION@

postinst_found=0

set -e

. /usr/share/debconf/confmodule

AMLDIR=@amldir@

db_get ${DKMS_PACKAGE_NAME}/max9x
MAX9X=${RET}
db_get ${DKMS_PACKAGE_NAME}/ipu
IPU=${RET}
db_get ${DKMS_PACKAGE_NAME}/board
BOARD=${RET}
db_get ${DKMS_PACKAGE_NAME}/sensor
SENSOR=${RET}

# Derive the AML path
AML="${AMLDIR}/${IPU}/${BOARD}_${SENSOR}.aml"

DIR="kernel/firmware/acpi"

case "$1" in
	configure|triggered)
		if [ "$MAX9X" = "maxim-serdes" ]; then
			echo "postinst build for ${MAX9X} ACPI SSDT-overlay ${IPU}/${BOARD}_${SENSOR}.aml" >&2
			echo "clear MAKE_OPTS" >&2
			export MAKE_OPTS=""
			export SKIP_MAXIM_SERDES=0

			if [ -e $AML ]; then

				mkdir -p "$DIR"
				cp "$AML" "$DIR"
				find kernel | cpio -H newc --create > ${IPU}_${BOARD}_${SENSOR}_ssdt.img
				rm -rf "$DIR"
				cp ${IPU}_${BOARD}_${SENSOR}_ssdt.img /boot
				echo "GRUB_EARLY_INITRD_LINUX_CUSTOM=\"${IPU}_${BOARD}_${SENSOR}_ssdt.img\"" > /etc/default/grub.d/ssdt.cfg
				if command -v update-grub > /dev/null && [ -d /boot/grub ]; then
			   	   update-grub || :
				fi
			fi
		else
			echo "postinst build for ${MAX9X} ACPI built-in PDATA (SKIP_MAXIM_SERDES=1) " >&2
			export SKIP_MAXIM_SERDES=1
			echo "clear MAKE_OPTS" >&2
			export MAKE_OPTS=""
		fi
		for DKMS_POSTINST in /usr/lib/dkms/common.postinst /usr/share/$DKMS_PACKAGE_NAME/postinst; do
			if [ -f $DKMS_POSTINST ]; then
				$DKMS_POSTINST $DKMS_NAME $DKMS_VERSION /usr/share/$DKMS_PACKAGE_NAME "" $2
				postinst_found=1
				break
			fi
		done
		if [ "$postinst_found" -eq 0 ]; then
			echo "ERROR: DKMS version is too old and $DKMS_PACKAGE_NAME was not"
			echo "built with legacy DKMS support."
			echo "You must either rebuild $DKMS_PACKAGE_NAME with legacy postinst"
			echo "support or upgrade DKMS to a more current version."
			exit 1
		fi
	;;
esac
# End automatically added section
