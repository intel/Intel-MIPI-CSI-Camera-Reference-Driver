From 74bb24807bea4a94248b9862be68f5d1991ed4f1 Mon Sep 17 00:00:00 2001
From: florent pirou <florent.pirou@intel.com>
Date: Thu, 27 Aug 2026 03:40:29 -0700
Subject: [PATCH 53/62] ipu6: k7 api compat

Signed-off-by: florent pirou <florent.pirou@intel.com>
---
 ipu6-drivers/drivers/media/pci/intel/ipu-isys-csi2.c       | 5 +++++
 .../drivers/media/pci/intel/ipu6/ipu6-isys-queue.c         | 2 ++
 .../drivers/media/pci/intel/ipu6/ipu6-isys-video.c         | 2 --
 ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys.c      | 7 +++++++
 4 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/ipu6-drivers/drivers/media/pci/intel/ipu-isys-csi2.c b/ipu6-drivers/drivers/media/pci/intel/ipu-isys-csi2.c
index 803a4ac..7625ce8 100644
--- a/ipu6-drivers/drivers/media/pci/intel/ipu-isys-csi2.c
+++ b/ipu6-drivers/drivers/media/pci/intel/ipu-isys-csi2.c
@@ -102,7 +102,12 @@ int ipu_isys_csi2_get_link_freq(struct ipu_isys_csi2 *csi2, s64 *link_freq)
 	bpp = ipu_isys_mbus_code_to_bpp(csi2->asd.ffmt->code);
 	lanes = csi2->nlanes;
 
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+	ret = v4l2_get_link_freq(pipe->external, bpp, lanes * 2);
+#else
 	ret = v4l2_get_link_freq(ext_sd->ctrl_handler, bpp, lanes * 2);
+#endif
 	if (ret < 0) {
 		dev_err(dev, "can't get link frequency (%lld)\n", ret);
 		return ret;
diff --git a/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c b/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c
index 67cf253..d91b919 100644
--- a/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c
+++ b/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys-queue.c
@@ -1061,8 +1061,10 @@ void ipu6_isys_queue_buf_ready(struct ipu6_isys_stream *stream,
 
 static const struct vb2_ops ipu6_isys_queue_ops = {
 	.queue_setup = ipu6_isys_queue_setup,
+#if LINUX_VERSION_CODE < KERNEL_VERSION(7, 0, 0)
 	.wait_prepare = vb2_ops_wait_prepare,
 	.wait_finish = vb2_ops_wait_finish,
+#endif
 	.buf_init = ipu6_isys_buf_init,
 	.buf_prepare = ipu6_isys_buf_prepare,
 	.buf_cleanup = ipu6_isys_buf_cleanup,
diff --git a/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys-video.c b/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys-video.c
index c8e2955..a280ef6 100644
--- a/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys-video.c
+++ b/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys-video.c
@@ -1064,8 +1064,6 @@ static u32 get_remote_pad_stream(struct media_pad *r_pad)
 		return 0;
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
-	/* Use routing API for 6.18+. r_pad is the SOURCE pad on the CSI2
-	 * subdev, so match on source_pad and return source_stream. */
 	struct v4l2_subdev_route *route;
 	for_each_active_route(&state->routing, route) {
 		if (route->source_pad == r_pad->index) {
diff --git a/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys.c b/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys.c
index 36f8086..c7f5305 100644
--- a/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys.c
+++ b/ipu6-drivers/drivers/media/pci/intel/ipu6/ipu6-isys.c
@@ -1008,9 +1008,16 @@ static int isys_notifier_bound(struct v4l2_async_notifier *notifier,
 
 	dev_dbg(&isys->adev->auxdev.dev, "bind %s nlanes is %d port is %d\n",
 		sd->name, s_asd->csi2.nlanes, s_asd->csi2.port);
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(7, 0, 0)
+	/* src_pad member was removed from v4l2_async_match_desc in newer kernels. */
+	ret = isys_complete_ext_device_registration(isys, sd, -1,
+					    &s_asd->csi2);
+#else
 	ret = isys_complete_ext_device_registration(isys, sd,
 						    -1,
 						    &s_asd->csi2);
+#endif
 	if (ret)
 		return ret;
 
-- 
2.43.0

